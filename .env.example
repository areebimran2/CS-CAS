# Copy this file to .env and fill in the values. .env is read by Django (cs_cas/settings.py) and by
# Docker Compose (compose.yaml). Never commit .env.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Wrap values in single quotes if they contain '#', '$' or spaces.

# Django
DJANGO_SECRET_KEY='change-me'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (POSTGRES_PORT is the host port published by compose.yaml)
POSTGRES_DB=cs_cas
POSTGRES_USER=cs_cas
POSTGRES_PASSWORD='change-me'
POSTGRES_HOST=localhost
POSTGRES_PORT=5431

# Redis
REDIS_URL=redis://localhost:6378/0

# S3-compatible object storage. Locally, the access and secret keys are also the Silo root login
# (secret key: 8+ characters).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cscas
S3_SECRET_KEY='change-me'
S3_BUCKET_NAME=cs-cas
S3_PUBLIC_URL=http://localhost:9000/cs-cas

# External integrations
GOOGLE_PLACES_API_KEY=

# Delivery backends (defaults print to the console)
# TWO_FACTOR_SMS_GATEWAY=two_factor.gateways.fake.Fake
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
